# Source from the repository root. This is an engineering pilot, not a paper run.
export PY="${PY:-python}"
export MODEL="${MODEL:-${PWD}/models/Qwen3.5-2B-Base}"
export GPU_COUNT=1
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export RUN_EVALUATION=0
export SAE_MODES=mean,cross
export TARGET_TRAIN_TOKENS=32768
export TARGET_VALIDATION_TOKENS=8192
