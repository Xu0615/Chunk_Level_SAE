export WARMUP_STEPS=16
export VALIDATE_EVERY=32
export SAVE_EVERY=64
export FORWARD_BATCH_SIZE=8
export FORWARD_TOKEN_BUDGET=2048
export STREAM_SHUFFLE_BUFFER=256
export STREAM_TOKENIZER_THREADS=2
export STREAM_TOKENIZER_BATCH_SIZE=64
export STREAM_TOKENIZER_BATCH_CHARS=500000
export STREAM_SCHEDULER_WINDOW_PAIRS=256
export CACHE_SHARD_TOKENS=4096
export WRITER_BATCH_TOKENS=4096
